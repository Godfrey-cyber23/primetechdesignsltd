rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The current application treats authenticated users as administrators.
    // Replace this helper with a custom-claims check before production use.
    function isAdmin() {
      return request.auth != null;
    }

    // Contact submissions: visitors may create valid leads; administrators
    // may read and manage them.
    match /contact_submissions/{submissionId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.timestamp is timestamp;
      allow read, update, delete: if isAdmin();
    }

    // Public bot chat. Authenticated users may update or delete messages.
    match /chats/{chatId}/messages/{messageId} {
      allow create: if request.resource.data.text is string
                    && request.resource.data.sender is string
                    && request.resource.data.timestamp is timestamp;
      allow read: if true;
      allow update, delete: if isAdmin();

      // Required by the dashboard's threaded chat view.
      match /replies/{replyId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    // Public visitors can read published projects. Administrators can manage
    // all projects and their project-form documents.
    match /projects/{projectId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();

      match /forms/{formId} {
        allow read, write: if isAdmin();
      }
    }

    match /team_members/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_settings/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /analytics/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /project_counters/{counterId} {
      allow read, write: if isAdmin();
    }

    // Deny every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
