rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Authentication is required; approval status is enforced by
    // isApprovedAdmin for dashboard operations.
    function isAdmin() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return request.auth != null
        && request.auth.uid == 'sJSLqnZTFvcnubHnNyl1NJlMHy52';
    }

    function isSuperAdmin() {
      return isBootstrapAdmin();
    }

    // Dashboard accounts are approved manually by an administrator.
    function isApprovedAdmin() {
      return isBootstrapAdmin()
        || (isAdmin()
        && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.status == 'approved'
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.loginLocked != true
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.loginStatus != 'locked');
    }

    match /admin_users/{userId} {
      allow create: if isAdmin() && request.auth.uid == userId
                    && (request.resource.data.status == 'pending' || isBootstrapAdmin());
      allow read: if isApprovedAdmin();
      allow update: if isSuperAdmin()
              || (isAdmin() && request.auth.uid == userId
                && request.resource.data.status == resource.data.status
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'displayName', 'jobTitle', 'phone', 'photoURL', 'bio', 'updatedAt'
                ]));
      allow delete: if isSuperAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isApprovedAdmin();
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin()
                    || (isApprovedAdmin()
                        && resource.data.assignedTo == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'status', 'updatedAt'
                        ]));
    }

    match /admin_audit_logs/{logId} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /team_presence/{userId} {
      allow read: if isApprovedAdmin();
      allow create, update: if isApprovedAdmin() && request.auth.uid == userId;
      allow delete: if isApprovedAdmin() && request.auth.uid == userId;
    }

    function isCallParticipant(callId) {
      return isApprovedAdmin()
        && (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
          || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid);
    }

    match /calls/{callId} {
      allow create: if isApprovedAdmin()
                    && request.resource.data.callerId == request.auth.uid
                    && request.resource.data.calleeId is string;
      // The incoming-call listener queries by calleeId. Query rules must be
      // expressible from the returned document, so do not use get() here.
      allow read: if isApprovedAdmin()
                  && (resource.data.callerId == request.auth.uid
                    || resource.data.calleeId == request.auth.uid);
      allow update: if isCallParticipant(callId);
      allow delete: if isCallParticipant(callId);

      match /{candidateCollection}/{candidateId} {
        allow read, create: if isCallParticipant(callId);
      }
    }

    match /chat_channels/{channelId} {
      allow read, write: if isApprovedAdmin();
    }

    match /clients/{clientId} {
      allow create: if request.auth != null
                    && request.auth.uid == clientId;
      allow update: if isApprovedAdmin()
                    || (request.auth != null && request.auth.uid == clientId
                        && request.resource.data.status == resource.data.status);
      allow read, delete: if isApprovedAdmin();
    }

    match /chats/{chatId} {
      allow delete: if isApprovedAdmin();
    }

    // Contact submissions: visitors may create valid leads; administrators
    // may read and manage them.
    match /contact_submissions/{submissionId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.timestamp is timestamp;
      allow read, update, delete: if isApprovedAdmin();
    }

    // Public bot chat. Authenticated users may update or delete messages.
    match /chats/{chatId}/messages/{messageId} {
      allow create: if request.resource.data.text is string
                    && request.resource.data.sender is string
                    && request.resource.data.timestamp is timestamp;
      allow read: if true;
      allow update: if isApprovedAdmin()
                    || (isAdmin()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']));
      allow delete: if isApprovedAdmin();

      // Required by the dashboard's threaded chat view.
      match /replies/{replyId} {
        allow read: if true;
        allow create, update, delete: if isApprovedAdmin();
      }
    }

    // Public visitors can read published projects. Administrators can manage
    // all projects and their project-form documents.
    match /projects/{projectId} {
      allow read: if resource.data.isPublished == true || isApprovedAdmin();
      allow write: if isApprovedAdmin();

      match /forms/{formId} {
        allow read, write: if isApprovedAdmin();
      }
    }

    match /team_members/{memberId} {
      allow read: if true;
      allow write: if isApprovedAdmin();
    }

    match /site_settings/{documentId} {
      allow read: if true;
      allow write: if isApprovedAdmin();
    }

    match /analytics/{documentId} {
      allow read: if true;
      allow write: if isApprovedAdmin();
    }

    match /analytics_events/{eventId} {
      allow create: if request.resource.data.type in ['page_view', 'session_start', 'session_end']
                    && request.resource.data.sessionId is string
                    && request.resource.data.path is string
                    && request.resource.data.timestamp is timestamp;
      allow read: if isApprovedAdmin();
      allow update, delete: if isApprovedAdmin();
    }

    match /project_counters/{counterId} {
      allow read, write: if isApprovedAdmin();
    }

    // Deny every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
